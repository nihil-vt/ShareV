{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareV",
  "version": "0.3.0",
  "identifier": "dev.sharev.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShareV",
        "width": 980,
        "height": 620,
        "minWidth": 620,
        "minHeight": 64,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$TEMP/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "grim",
          "slurp",
          "wl-clipboard",
          "wf-recorder",
          "ffmpeg",
          "libnotify-bin"
        ],
        "files": {
          "/usr/share/metainfo/dev.sharev.app.metainfo.xml": "linux/dev.sharev.app.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/dev.sharev.app.metainfo.xml": "linux/dev.sharev.app.metainfo.xml"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RkZDN0YzQzgxQjVBMjYKUldRbVd4dkk4OGYvbGZEU0FQdFFocG03bnJrWVR6enVjS2FBak9GZEVZZXR4ekdYS3dMYzJRQXgK",
      "endpoints": [
        "https://github.com/nihil-vt/ShareV/releases/latest/download/latest.json"
      ]
    }
  }
}